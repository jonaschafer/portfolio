# Copy to .env.local and fill in your values

# Supabase (required for Sounds): Settings → API in your project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Sounds list (client-side); also used by wall-of-sound
SUPABASE_SERVICE_ROLE_KEY=       # Sounds add/save (server-side)

# Spotify (recommended for Sounds): paste Spotify links → instant metadata. Get from developers.spotify.com → Dashboard → Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube (optional): when Odesli fails to find YouTube links, search by title+artist. Get from console.cloud.google.com → APIs → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=

# Eero (optional, for /typing → WiFi unlock): see TYPING_EERO_SETUP.md.
# Get EERO_SESSION_TOKEN, EERO_NETWORK_ID and the EERO_PROFILE_ID_* values by
# running `node scripts/eero-login.mjs` locally — never fill these in here.
EERO_SESSION_TOKEN=
EERO_NETWORK_ID=
EERO_PROFILE_ID_KID1=
EERO_PROFILE_ID_KID2=
# Shared secret the /typing page sends so random visitors can't hit the
# unlock route. Must be NEXT_PUBLIC_ because the client calls it directly —
# pick any random string, it's a deterrent, not real security.
NEXT_PUBLIC_INTERNAL_API_SECRET=
